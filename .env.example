# API security
JWT_SECRET_KEY=another-secret-change-me
JWT_ACCESS_TOKEN_EXPIRES=900
PORT=5000

# MongoDB connection
MONGO_URI=mongodb://mongo:27017
MONGO_DB_NAME=gateway

# MQTT broker (esterno)
MQTT_BROKER_HOST=mqtt.local
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=web-gateway
MQTT_SUBSCRIBE_TOPIC=gateway/in/#
MQTT_PUBLISH_TOPIC=gateway/out
MQTT_QOS=1

# Default admin (fallback se setup non completato)
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=admin123

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:8080
